+    if (statut === "partielle") return "Payé en partie — reste à crédit";
+    return statut; // ne devrait pas arriver (payee + credit > 0 est incohérent)
+  }
+  return statut === "payee" ? "Payé" : statut === "partielle" ? "Payé en partie" : "Impayé";
+}
 
